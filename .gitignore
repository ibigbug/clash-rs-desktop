# Rust build output
/target/

# windows-reactor generated staging folders
/temp/
/winmd/

# Local development runtime assets, downloaded cores, and generated configs.
# Not anchored: `--dev` resolves `.dev/` relative to the working directory, so
# it can appear nested (e.g. under a crate) depending on where the UI is run.
.dev/

# Packaged release output (produced by scripts/package-portable.ps1)
/dist/

# Ad-hoc test/diagnostic output captured to disk
test_out.txt

# Logs and crash dumps
*.log
*.dmp
*.pdb

# Local environment files
.env
.env.*
!.env.example

# Editor and OS noise
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Windows shortcut/zone metadata side files
*.lnk
*.Zone.Identifier

# clash-rs core fetched at bundle time (app/scripts/fetch-core.mjs)
/app/src-tauri/core/
